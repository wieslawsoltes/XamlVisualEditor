<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             x:Class="XamlVisualEditor.App.Views.ExtensionWebviewView"
             x:DataType="vm:ExtensionWebviewViewModel">
  <Border Padding="12">
    <TextBlock Text="{CompiledBinding PlaceholderMessage}" TextWrapping="Wrap" />
  </Border>
</UserControl>
