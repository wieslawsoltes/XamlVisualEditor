<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:ce="using:XamlVisualEditor.CodeEditor"
             xmlns:input="using:Avalonia.Input"
             x:Class="XamlVisualEditor.App.Views.XamlCodeEditorView"
             x:DataType="ce:CodeEditorViewModel">

    <DockPanel>
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4,2">
            <Button ToolTip.Tip="Undo" Command="{CompiledBinding UndoCommand}" Padding="6,2">
                <PathIcon Width="14" Height="14" Data="M12.5 8c-2.65 0-5.05 1.04-6.83 2.75L3 8v8h8l-2.81-2.81C9.83 11.87 11.1 11 12.5 11c2.34 0 4.33 1.57 4.93 3.7l2.14-.7C18.63 10.73 15.84 8 12.5 8z" />
            </Button>
            <Button ToolTip.Tip="Redo" Command="{CompiledBinding RedoCommand}" Padding="6,2">
                <PathIcon Width="14" Height="14" Data="M18.4 10.6C16.55 9 14.15 8 11.5 8c-3.34 0-6.13 2.73-7.07 6l2.14.7c.6-2.13 2.59-3.7 4.93-3.7 1.4 0 2.67.87 3.31 2.19L12 16h8V8l-1.6 2.6z" />
            </Button>
            <Separator />
            <Button ToolTip.Tip="Format Document" Command="{CompiledBinding FormatDocumentCommand}" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Width="14" Height="14" Data="M3 21h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18v-2H3v2zm0-4h18V7H3v2zm0-6v2h18V3H3z" />
                    <TextBlock Text="Format" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </Button>
            <Separator />
            <ToggleButton IsChecked="{CompiledBinding WordWrap, Mode=TwoWay}" ToolTip.Tip="Word Wrap" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Width="14" Height="14" Data="M4 19h6v-2H4v2zM20 5H4v2h16V5zM17 11H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2.25c2.21 0 4-1.79 4-4s-1.79-4-4-4z" />
                    <TextBlock Text="Wrap" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton IsChecked="{CompiledBinding ShowLineNumbers, Mode=TwoWay}" ToolTip.Tip="Show Line Numbers" Padding="6,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon Width="14" Height="14" Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z" />
                    <TextBlock Text="Ln#" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- Code editor -->
        <ae:TextEditor Name="TextEditor"
                   input:DragDrop.AllowDrop="True"
                       FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                       FontSize="14"
                       ShowLineNumbers="True"
                       Background="#1E1E1E"
                       Foreground="#D4D4D4"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
    </DockPanel>

</UserControl>
