<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             x:Class="XamlVisualEditor.App.Views.OutputView"
             x:DataType="vm:OutputViewModel">

    <DockPanel>
        <!-- Output toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4,2">
            <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" />
            <Separator />
            <TextBlock Text="{CompiledBinding ErrorCount, StringFormat='Errors: {0}'}"
                       Foreground="Red" VerticalAlignment="Center" Margin="4,0" />
            <TextBlock Text="{CompiledBinding WarningCount, StringFormat='Warnings: {0}'}"
                       Foreground="Orange" VerticalAlignment="Center" Margin="4,0" />
            <Separator />
            <Button Content="Copy Selected" Command="{CompiledBinding CopySelectedCommand}" Padding="6,2" />
            <Button Content="Copy All" Command="{CompiledBinding CopyAllCommand}" Padding="6,2" />
            <Button Content="Clear" Command="{CompiledBinding ClearCommand}" Padding="6,2" />
        </StackPanel>

        <!-- Message list -->
        <dg:DataGrid ItemsSource="{CompiledBinding Messages}"
                     SelectedItem="{CompiledBinding SelectedMessage, Mode=TwoWay}"
                     AutoGenerateColumns="False"
                     GridLinesVisibility="None"
                     IsReadOnly="True">
            <dg:DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selected" Command="{CompiledBinding CopySelectedCommand}" />
                    <MenuItem Header="Copy All" Command="{CompiledBinding CopyAllCommand}" />
                </ContextMenu>
            </dg:DataGrid.ContextMenu>
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Header="Level" Binding="{CompiledBinding Level}" Width="80" />
                <dg:DataGridTemplateColumn Header="Message" Width="2*">
                    <dg:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:OutputMessage">
                            <TextBlock Text="{CompiledBinding Text}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </dg:DataGridTemplateColumn.CellTemplate>
                </dg:DataGridTemplateColumn>
                <dg:DataGridTextColumn Header="Line" Binding="{CompiledBinding Line}" Width="80" />
                <dg:DataGridTextColumn Header="Column" Binding="{CompiledBinding Column}" Width="80" />
            </dg:DataGrid.Columns>
        </dg:DataGrid>
    </DockPanel>

</UserControl>
