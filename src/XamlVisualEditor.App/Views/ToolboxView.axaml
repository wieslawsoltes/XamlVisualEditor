<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             x:Class="XamlVisualEditor.App.Views.ToolboxView"
             x:DataType="vm:ToolboxViewModel">

    <DockPanel>
        <TextBox DockPanel.Dock="Top"
                 Watermark="Search controls..."
                 Text="{CompiledBinding SearchText, Mode=TwoWay}"
                 Margin="4" />

        <ListBox Name="ToolboxList"
                 ItemsSource="{CompiledBinding Items}"
                 Margin="4">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolboxItemViewModel">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                IsVisible="{CompiledBinding IsVisible}">
                        <TextBlock Text="▣" Foreground="{DynamicResource SystemAccentColor}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{CompiledBinding DisplayName}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>

</UserControl>
