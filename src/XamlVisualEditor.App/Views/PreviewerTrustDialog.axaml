<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
        x:Class="XamlVisualEditor.App.Views.PreviewerTrustDialog"
        x:DataType="vm:PreviewerTrustDialogViewModel"
        Width="460" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    <Border Background="#22000000" Padding="8" CornerRadius="4">
      <TextBlock Text="{CompiledBinding Location}" TextWrapping="Wrap" />
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Command="{CompiledBinding CancelCommand}" IsCancel="True" />
      <Button Content="Allow Once" Command="{CompiledBinding AllowOnceCommand}" />
      <Button Content="Trust Workspace" Command="{CompiledBinding TrustCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
