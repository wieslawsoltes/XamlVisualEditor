<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
        x:Class="XamlVisualEditor.App.Views.MessageDialog"
        x:DataType="vm:MessageDialogViewModel"
        Width="420"
        Height="180"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="{CompiledBinding Title}" FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="OK" Command="{CompiledBinding ConfirmCommand}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
