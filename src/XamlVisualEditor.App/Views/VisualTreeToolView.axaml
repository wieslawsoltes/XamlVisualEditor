<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:XamlVisualEditor.Shell"
             xmlns:v="using:XamlVisualEditor.App.Views"
             x:Class="XamlVisualEditor.App.Views.VisualTreeToolView"
             x:DataType="shell:VisualTreeTool">
  <v:VisualTreePanelView
      DataContext="{CompiledBinding MainViewModel.VisualTree}" />
</UserControl>
