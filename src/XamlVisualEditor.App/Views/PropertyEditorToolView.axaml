<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="using:XamlVisualEditor.Shell"
             xmlns:v="using:XamlVisualEditor.App.Views"
             x:Class="XamlVisualEditor.App.Views.PropertyEditorToolView"
             x:DataType="shell:PropertyEditorTool">
  <v:PropertyEditorView
      DataContext="{CompiledBinding PropertyEditor}" />
</UserControl>
