<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
             xmlns:v="using:XamlVisualEditor.App.Views"
             x:Class="XamlVisualEditor.App.Views.TextFileView"
             x:DataType="vm:TextDocumentViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="4,2">
      <ToggleButton IsChecked="{CompiledBinding WordWrap, Mode=TwoWay}" ToolTip.Tip="Word Wrap" Padding="6,2">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Width="14" Height="14" Data="M4 19h6v-2H4v2zM20 5H4v2h16V5zM17 11H4v2h13.25c1.1 0 2 .9 2 2s-.9 2-2 2H15v-2l-3 3 3 3v-2h2.25c2.21 0 4-1.79 4-4s-1.79-4-4-4z" />
          <TextBlock Text="Wrap" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </ToggleButton>
      <ToggleButton IsChecked="{CompiledBinding ShowLineNumbers, Mode=TwoWay}" ToolTip.Tip="Show Line Numbers" Padding="6,2">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <PathIcon Width="14" Height="14" Data="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z" />
          <TextBlock Text="Ln#" VerticalAlignment="Center" FontSize="12" />
        </StackPanel>
      </ToggleButton>
    </StackPanel>

    <ae:TextEditor Name="TextEditor"
             v:BreakpointMarginBehavior.IsEnabled="True"
             v:BreakpointMarginBehavior.Breakpoints="{CompiledBinding Breakpoints}"
                   v:BreakpointMarginBehavior.FilePath="{CompiledBinding FilePath}"
                   v:BreakpointMarginBehavior.ExecutionLine="{CompiledBinding ExecutionLine}"
                   FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                   FontSize="14"
                   ShowLineNumbers="True"
                   Background="#1E1E1E"
                   Foreground="#D4D4D4"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</UserControl>
