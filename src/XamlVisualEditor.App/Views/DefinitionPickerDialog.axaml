<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="using:Avalonia.Controls"
        xmlns:vm="using:XamlVisualEditor.Shell.ViewModels"
        x:Class="XamlVisualEditor.App.Views.DefinitionPickerDialog"
        x:DataType="vm:DefinitionPickerDialogViewModel"
        Width="520"
        Height="360"
        CanResize="True"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top"
               Text="{CompiledBinding Title}"
               FontWeight="SemiBold"
               Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button Content="Open"
              Command="{CompiledBinding OpenCommand}"
              MinWidth="80" />
      <Button Content="Cancel"
              Command="{CompiledBinding CancelCommand}"
              MinWidth="80" />
    </StackPanel>

    <dg:DataGrid ItemsSource="{CompiledBinding Items}"
                SelectedItem="{CompiledBinding SelectedItem, Mode=TwoWay}"
                HeadersVisibility="None"
                GridLinesVisibility="None"
                AutoGenerateColumns="False"
                CanUserSortColumns="True"
                IsReadOnly="True">
      <dg:DataGrid.Columns>
        <dg:DataGridTemplateColumn Header="Definition" Width="*">
          <dg:DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ReferenceLocationViewModel">
              <StackPanel Spacing="2">
                <TextBlock Text="{CompiledBinding DisplayText}" />
                <TextBlock Text="{CompiledBinding FilePath}"
                           Opacity="0.6"
                           FontSize="11" />
              </StackPanel>
            </DataTemplate>
          </dg:DataGridTemplateColumn.CellTemplate>
        </dg:DataGridTemplateColumn>
      </dg:DataGrid.Columns>
      <dg:DataGrid.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{CompiledBinding OpenCommand}" />
        <KeyBinding Gesture="Return" Command="{CompiledBinding OpenCommand}" />
      </dg:DataGrid.KeyBindings>
    </dg:DataGrid>
  </DockPanel>
</Window>
