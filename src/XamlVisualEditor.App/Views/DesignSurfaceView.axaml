<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dc="using:XamlVisualEditor.Designer.Core"
             xmlns:input="using:Avalonia.Input"
             xmlns:ad="using:XamlVisualEditor.Designer.Adorners"
             x:Class="XamlVisualEditor.App.Views.DesignSurfaceView"
             x:DataType="dc:DesignSurfaceViewModel"
             Background="#1E1E1E"
             Focusable="True"
             input:DragDrop.AllowDrop="True">

    <DockPanel>
        <!-- Design surface toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="4,0" FontSize="12" />
                <Slider Minimum="0.25" Maximum="4.0"
                        Value="{CompiledBinding Zoom, Mode=TwoWay}"
                        Width="120"
                        VerticalAlignment="Center" />
                <TextBlock Text="{CompiledBinding Zoom, StringFormat='{}{0:P0}'}"
                           VerticalAlignment="Center" Margin="4,0" FontSize="12" />
                <Separator />
                <ToggleButton IsChecked="{CompiledBinding ShowGrid, Mode=TwoWay}"
                              Content="Grid" Padding="6,2" FontSize="12" />
                <ToggleButton IsChecked="{CompiledBinding SnapToGrid, Mode=TwoWay}"
                              Content="Snap Grid" Padding="6,2" FontSize="12" />
                <Separator />
                <ToggleButton IsChecked="{CompiledBinding ShowAlignmentGuides, Mode=TwoWay}"
                              Content="Align" Padding="6,2" FontSize="12" />
                <ToggleButton IsChecked="{CompiledBinding SnapLinesEnabled, Mode=TwoWay}"
                              Content="Snap Align" Padding="6,2" FontSize="12" />
                <ToggleButton IsChecked="{CompiledBinding ShowSpacingGuides, Mode=TwoWay}"
                              Content="Spacing" Padding="6,2" FontSize="12" />
                <Separator />
                <ToggleButton IsChecked="{CompiledBinding ShowGuides, Mode=TwoWay}"
                              Content="Guides" Padding="6,2" FontSize="12" />
                <ToggleButton IsChecked="{CompiledBinding SnapToGuides, Mode=TwoWay}"
                              Content="Snap Guides" Padding="6,2" FontSize="12" />
                <ToggleButton IsChecked="{CompiledBinding ShowRulers, Mode=TwoWay}"
                              Content="Rulers" Padding="6,2" FontSize="12" />
                <Separator />
                <ToggleButton IsChecked="{CompiledBinding ShowMarginPadding, Mode=TwoWay}"
                              Content="Margin" Padding="6,2" FontSize="12" />
                <Separator />
                <ToggleButton IsChecked="{CompiledBinding IsEditMode, Mode=TwoWay}"
                              Content="Edit" Padding="6,2" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Artboard / design canvas with rulers -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    Width="24" Height="24"
                    Background="#252526"
                    IsVisible="{CompiledBinding ShowRulers}" />

            <ad:RulerControl Name="HorizontalRuler"
                             Grid.Row="0" Grid.Column="1"
                             Height="24"
                             Orientation="Horizontal"
                             Zoom="{CompiledBinding Zoom}"
                             Guides="{CompiledBinding VerticalGuides}"
                             IsVisible="{CompiledBinding ShowRulers}" />

            <ad:RulerControl Name="VerticalRuler"
                             Grid.Row="1" Grid.Column="0"
                             Width="24"
                             Orientation="Vertical"
                             Zoom="{CompiledBinding Zoom}"
                             Guides="{CompiledBinding HorizontalGuides}"
                             IsVisible="{CompiledBinding ShowRulers}" />

            <ScrollViewer Name="SurfaceScrollViewer"
                          Grid.Row="1" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          input:DragDrop.AllowDrop="True">
                <Border BorderBrush="#3F3F46"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        BoxShadow="0 2 8 0 #40000000">
                    <!-- The design canvas where controls are rendered -->
                    <Grid Width="{CompiledBinding CanvasWidth}"
                          Height="{CompiledBinding CanvasHeight}">
                        <ad:DesignGridLayer ShowGrid="{CompiledBinding ShowGrid}"
                                            GridSize="{CompiledBinding GridSnapSize}" />
                        <Panel Name="DesignCanvas"
                               Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                               ClipToBounds="True"
                               input:DragDrop.AllowDrop="True">
                            <!-- Child controls will be added programmatically -->
                        </Panel>
                        <ad:DesignAdornerLayer Name="AdornerLayer"
                                               IsVisible="{CompiledBinding IsEditMode}" />
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>

</UserControl>
