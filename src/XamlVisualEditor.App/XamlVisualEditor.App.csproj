<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XamlVisualEditor.App</RootNamespace>
    <Description>Avalonia application entry point, composition root, views, and resource dictionaries</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="ProDiagnostics" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="ProDataGrid" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.ReactiveUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.Fody" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XamlVisualEditor.Core\XamlVisualEditor.Core.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Xaml.Parsing\XamlVisualEditor.Xaml.Parsing.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Xaml.Ast\XamlVisualEditor.Xaml.Ast.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Xaml.Serialization\XamlVisualEditor.Xaml.Serialization.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Xaml.Intellisense\XamlVisualEditor.Xaml.Intellisense.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Workspace\XamlVisualEditor.Workspace.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Designer.Core\XamlVisualEditor.Designer.Core.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Designer.Rendering\XamlVisualEditor.Designer.Rendering.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Designer.DragDrop\XamlVisualEditor.Designer.DragDrop.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Designer.Adorners\XamlVisualEditor.Designer.Adorners.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.TreeView\XamlVisualEditor.TreeView.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.PropertyEditor\XamlVisualEditor.PropertyEditor.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.CodeEditor\XamlVisualEditor.CodeEditor.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Language\XamlVisualEditor.Language.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.CSharp.Language\XamlVisualEditor.CSharp.Language.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Xaml.Language\XamlVisualEditor.Xaml.Language.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Sync\XamlVisualEditor.Sync.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Collaboration\XamlVisualEditor.Collaboration.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Collaboration.UI\XamlVisualEditor.Collaboration.UI.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Shell\XamlVisualEditor.Shell.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Shell.ViewModels\XamlVisualEditor.Shell.ViewModels.csproj" />
    <ProjectReference Include="..\XamlVisualEditor.Designer.PreviewerHost\XamlVisualEditor.Designer.PreviewerHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPreviewerHost" AfterTargets="Build">
    <MSBuild Projects="..\XamlVisualEditor.Designer.PreviewerHost\XamlVisualEditor.Designer.PreviewerHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <_PreviewerHost Include="..\XamlVisualEditor.Designer.PreviewerHost\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_PreviewerHost Include="..\XamlVisualEditor.Designer.PreviewerHost\bin\$(Configuration)\$(TargetFramework)\XamlVisualEditor.Designer.PreviewerHost.runtimeconfig.json" />
      <_PreviewerHost Include="..\XamlVisualEditor.Designer.PreviewerHost\bin\$(Configuration)\$(TargetFramework)\XamlVisualEditor.Designer.PreviewerHost.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_PreviewerHost)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
