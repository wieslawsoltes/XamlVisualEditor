<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="using:XamlVisualEditor.Terminal"
             xmlns:controls="using:XamlVisualEditor.Terminal.Avalonia.Controls"
             xmlns:v="using:XamlVisualEditor.Terminal.Avalonia.Views"
             x:DataType="term:ITerminalViewModel"
             x:Class="XamlVisualEditor.Terminal.Avalonia.Views.TerminalView">
  <Grid>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <controls:TerminalControl TerminalViewModel="{CompiledBinding}"
                                v:TerminalInputBehavior.ViewModel="{CompiledBinding}"
                                FontFamily="Cascadia Mono, Menlo, Consolas, monospace"
                                FontSize="13"
                                Focusable="True" />
    </ScrollViewer>
  </Grid>
</UserControl>
