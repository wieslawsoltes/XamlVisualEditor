<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia -->
    <PackageVersion Include="Avalonia" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.11" />
    <PackageVersion Include="ProDataGrid" Version="11.3.11-preview.6" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="11.3.11" />
    <!-- AvaloniaEdit -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.1.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="11.1.0" />
    <!-- Dock -->
    <PackageVersion Include="Dock.Avalonia" Version="11.3.0.13" />
    <PackageVersion Include="Dock.Model.ReactiveUI" Version="11.3.0.13" />
    <PackageVersion Include="Dock.Serializer.SystemTextJson" Version="11.3.0.13" />
    <!-- ReactiveUI -->
    <PackageVersion Include="ReactiveUI" Version="20.2.45" />
    <PackageVersion Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.8" />
    <!-- MSBuild / Roslyn -->
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <!-- DI -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
    <!-- TextMate -->
    <PackageVersion Include="TextMateSharp.Grammars" Version="1.0.65" />
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- System.Reactive -->
    <PackageVersion Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>
</Project>
