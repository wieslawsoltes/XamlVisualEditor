<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XamlVisualEditor.DotNetTemplatesExtension.ViewModels"
        x:Class="XamlVisualEditor.DotNetTemplatesExtension.Views.WorkspaceOpenPromptDialog"
        x:DataType="vm:WorkspaceOpenPromptDialogViewModel"
        Width="420"
        Height="180"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="{CompiledBinding Title}"
               FontSize="16"
               FontWeight="SemiBold" />
    <TextBlock Text="{CompiledBinding Message}"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="Open"
              Command="{CompiledBinding OpenCurrentCommand}"
              MinWidth="90" />
      <Button Content="Open in New Window"
              Command="{CompiledBinding OpenNewWindowCommand}"
              MinWidth="160" />
      <Button Content="Cancel"
              Command="{CompiledBinding CancelCommand}"
              MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
