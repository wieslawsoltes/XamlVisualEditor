<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dg="using:Avalonia.Controls"
             xmlns:controls="using:XamlVisualEditor.GitExtension.Controls"
             xmlns:vm="using:XamlVisualEditor.GitExtension"
             x:Class="XamlVisualEditor.GitExtension.Views.GitPanelView"
             x:DataType="vm:GitPanelViewModel">

    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*">
        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="8,6" LastChildFill="True">
            <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left">
                <TextBlock Text="Git" FontWeight="SemiBold" />
                <TextBlock Text="|" Opacity="0.4" />
                <TextBlock Text="Branch:" Opacity="0.7" />
                <TextBlock Text="{CompiledBinding BranchName}" />
                <TextBlock Text="Upstream:" Opacity="0.7" Margin="8,0,0,0" />
                <TextBlock Text="{CompiledBinding UpstreamName}" />
                <TextBlock Text="Ahead:" Opacity="0.7" Margin="8,0,0,0" />
                <TextBlock Text="{CompiledBinding AheadBy}" />
                <TextBlock Text="Behind:" Opacity="0.7" Margin="8,0,0,0" />
                <TextBlock Text="{CompiledBinding BehindBy}" />
            </StackPanel>

            <Button Content="Refresh"
                    Command="{CompiledBinding RefreshCommand}"
                    Padding="8,2"
                    DockPanel.Dock="Right" />
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="8,0,8,6" LastChildFill="True">
            <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left">
                <TextBox Width="200"
                         Watermark="Search changes..."
                         Text="{CompiledBinding SearchText, Mode=TwoWay}" />
                <Button Content="Stage" Command="{CompiledBinding StageCommand}" Padding="8,2" />
                <Button Content="Unstage" Command="{CompiledBinding UnstageCommand}" Padding="8,2" />
                <Button Content="Discard" Command="{CompiledBinding DiscardCommand}" Padding="8,2" />
                <Button Content="Stage All" Command="{CompiledBinding StageAllCommand}" Padding="8,2" />
                <Button Content="Unstage All" Command="{CompiledBinding UnstageAllCommand}" Padding="8,2" />
            </StackPanel>
            <TextBlock Text="{CompiledBinding ErrorMessage}"
                       Foreground="Orange"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right" />
        </DockPanel>

        <!-- Main content -->
        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" RowDefinitions="*" Margin="8">
            <TabControl Grid.Row="0" Grid.Column="0">
                <TabItem Header="{CompiledBinding StagedCount, StringFormat='Staged ({0})'}">
                    <dg:DataGrid ItemsSource="{CompiledBinding StagedView}"
                                 SelectedItem="{CompiledBinding SelectedStagedChange, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 CanUserSortColumns="True"
                                 GridLinesVisibility="None"
                                 IsReadOnly="True">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="Path"
                                                   Width="*"
                                                   x:DataType="vm:GitChangeEntryViewModel"
                                                   Binding="{CompiledBinding DisplayPath}" />
                            <dg:DataGridTextColumn Header="Status"
                                                   Width="120"
                                                   x:DataType="vm:GitChangeEntryViewModel"
                                                   Binding="{CompiledBinding StatusLabel}" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                </TabItem>
                <TabItem Header="{CompiledBinding UnstagedCount, StringFormat='Unstaged ({0})'}">
                    <dg:DataGrid ItemsSource="{CompiledBinding UnstagedView}"
                                 SelectedItem="{CompiledBinding SelectedUnstagedChange, Mode=TwoWay}"
                                 AutoGenerateColumns="False"
                                 CanUserSortColumns="True"
                                 GridLinesVisibility="None"
                                 IsReadOnly="True">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="Path"
                                                   Width="*"
                                                   x:DataType="vm:GitChangeEntryViewModel"
                                                   Binding="{CompiledBinding DisplayPath}" />
                            <dg:DataGridTextColumn Header="Status"
                                                   Width="120"
                                                   x:DataType="vm:GitChangeEntryViewModel"
                                                   Binding="{CompiledBinding StatusLabel}" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                </TabItem>
            </TabControl>

            <DockPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="Commit" FontWeight="SemiBold" />
                    <TextBox Watermark="Commit message"
                             Text="{CompiledBinding CommitMessage, Mode=TwoWay}" />
                    <Button Content="Commit" Command="{CompiledBinding CommitCommand}" Padding="8,2" />
                    <TextBlock Text="{CompiledBinding DiffLineCount, StringFormat='Diff ({0})'}"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                </StackPanel>

                <Border BorderBrush="#333" BorderThickness="1" Padding="4">
                    <controls:GitDiffTextEditor DiffLines="{CompiledBinding DiffLines}"
                                                IsReadOnly="True"
                                                ShowLineNumbers="True"
                                                FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                                FontSize="14"
                                                Background="#1E1E1E"
                                                Foreground="#D4D4D4"
                                                HorizontalScrollBarVisibility="Auto"
                                                VerticalScrollBarVisibility="Auto" />
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
